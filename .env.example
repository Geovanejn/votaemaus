# Configuracao do Administrador
ADMIN_EMAIL=seu_email@exemplo.com
ADMIN_PASSWORD=sua_senha_segura

# Instagram API
INSTAGRAM_ACCESS_TOKEN=seu_token_aqui
INSTAGRAM_USER_ID=seu_user_id_aqui

# Banco de Dados (configurado automaticamente no Replit)
DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# JWT e Sessao (gerados automaticamente)
JWT_SECRET=chave_secreta_jwt
SESSION_SECRET=chave_secreta_sessao

# Web Push VAPID Keys (gerados automaticamente)
VAPID_PUBLIC_KEY=chave_publica_vapid
VAPID_PRIVATE_KEY=chave_privada_vapid
VITE_VAPID_PUBLIC_KEY=mesma_chave_publica_vapid
